# Show date on startup
##?E `date`

# Set editor to vim
e cfg.editor=vim

# Show true colors
e scr.color=3

# Set theme
e scr.theme=onedark

# Set better output
e scr.utf8=true
e scr.utf8.curvy=true

# Show asm comments
e asm.describe=false

# Show comments at the right of disassembly if they fit
e asm.cmt.right=true

# Show pseudocode in disassembly
# e asm.pseudo=true

# Show intel syntax
e asm.syntax=intel

# Show all local variables
e asm.var.summary=0

# Update cmd prompt to current EIP
# e cmd.prompt=sr PC

# Get rid of annoying error at startup
e bin.relocs.apply=true

# Search in all areas
e search.in=dbg.maps

# Follow fork/clone calls
e dbg.follow.child=true

# Allow cacheing of file
e io.cache=1

# Use these commands when decompiling
# decai -e cmds=pdc,pdg,pdd,pdsf,ccf

# decai settings
decai -e api=ollama
decai -e baseurl=http://192.168.1.17:11434
decai -e cache=true
decai -e files=true
decai -e model=gpt-oss:20b
decai -e think=true
decai -e timeout=360
decai -e yolo=true

# r2ai settings
e r2ai.api=ollama
e r2ai.auto.max_runs=100
e r2ai.auto.yolo=true
e r2ai.baseurl=http://192.168.1.17:11434
e r2ai.data=true
e r2ai.data.reason=true
e r2ai.http.max_retries=6
e r2ai.http.timeout=360
e r2ai.http.use_files=true
e r2ai.max_tokens=16000
e r2ai.model=gpt-oss:20b
